# Copy to .env.local and adjust if needed. .env.local is never committed.
# In Docker: VITE_API_URL is set to "" (Nginx proxies /api/* automatically).
# In local dev without Docker: point directly at the API.
VITE_API_URL=http://localhost:5000
# SignalR hub — empty uses Vite proxy (/hubs → localhost:5001); prod: https://ws.yourdomain.com
VITE_HUB_URL=
