# Copy to .env and fill in real values. .env is never committed.

# PostgreSQL
POSTGRES_DB=taskflow
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_CONNECTION=Host=localhost;Port=5433;Database=taskflow;Username=YOUR_USER;Password=YOUR_PASSWORD
POSTGRES_CONNECTION_RAILWAY=Host=YOUR_RAILWAY_HOST;Port=YOUR_RAILWAY_PORT;Database=railway;Username=postgres;Password=YOUR_RAILWAY_PASSWORD

# Redis
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_CONNECTION=localhost:6379,password=YOUR_REDIS_PASSWORD

# JWT — generate with: openssl rand -base64 32
# (Windows without openssl: [Convert]::ToBase64String((1..32 | % { Get-Random -Min 0 -Max 256 })) )
JWT_SECRET=YOUR_256_BIT_SECRET_HERE

# CORS (comma-separated origins, used when hitting the API directly on :5000)
CORS_ORIGINS=http://localhost:3000

# RabbitMQ
RABBITMQ_USER=YOUR_RABBITMQ_USER
RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD

# Seq structured logging — http://localhost:5341 for local Docker, empty to disable
SEQ_URL=http://localhost:5341
SEQ_API_KEY=

# Blob storage — "local" uses Docker volume, "s3" uses S3-compatible (Cloudflare R2)
STORAGE_TYPE=local
S3_BUCKET_NAME=taskflow
S3_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY
S3_SECRET_KEY=YOUR_R2_SECRET_KEY
S3_REGION=auto

# Email / SMTP (dev: Mailpit runs in Docker on port 1025; prod: set to your SMTP provider)
# SMTP__HOST and SMTP__PORT are set automatically in docker-compose.yml for local dev.
# Override here only for prod or when running the API outside Docker.
# SMTP__HOST=smtp.resend.com
# SMTP__PORT=587
# SMTP__FROMEMAIL=noreply@yourdomain.com
# SMTP__FROMNAME=TaskFlow
# SMTP__USERNAME=resend
# SMTP__PASSWORD=YOUR_SMTP_PASSWORD

# Frontend base URL used to build invitation links (no trailing slash)
FRONTEND_BASE_URL=http://localhost:3000
